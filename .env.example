APP_NAME=DATN
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://quickcare.asia
FRONTEND_URL=https://quickcare.asia
SANCTUM_STATEFUL_DOMAINS=https://quickcare.asia

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=datn
DB_USERNAME=root
DB_PASSWORD=
DB_TIMEZONE=+07:00
QUEUE_CONNECTION=database

BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=10080

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
FRONTEND_BOOKING_URL=https://quickcare.asia/lichhen
FRONTEND_DOCTOR_BOOKING_URL=https://quickcare.asia/doctor/appointment

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher
# https://pusher.com/docs/channels/getting_started/rest_api
PUSHER_APP_ID=1973808
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
LARAVEL_WEBSOCKETS_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=ap1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Google
# https://developers.google.com/identity/protocols/oauth2/web-server
# https://developers.google.com/identity/protocols/oauth2/web-server#creatingcred
# https://developers.google.com/identity/protocols/oauth2/web-server#redirect-uri
# https://developers.google.com/identity/protocols/oauth2/web-server#handlingresponse
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://quickcare.asia/api/auth/google/callback

# GitHub
# https://docs.github.com/en/developers/apps/building-oauth-apps/creating-an-oauth-app
# https://docs.github.com/en/developers/apps/building-oauth-apps/authorizing-oauth-apps
# https://docs.github.com/en/developers/apps/building-oauth-apps/handling-oauth
# https://docs.github.com/en/developers/apps/building-oauth-apps/setting-up-your-development-environment
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://quickcare.asia/api/auth/github/callback

# Facebook
# https://developers.facebook.com/docs/facebook-login/web
# https://developers.facebook.com/docs/facebook-login/web/login-flow/
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://quickcare.asia/api/auth/facebook/callback

# Firebase
# https://firebase.google.com/docs/web/setup#add-sdk
# https://firebase.google.com/docs/admin/setup#initialize-sdk
FIREBASE_CREDENTIALS=firebase/firebase_credentials.json
FIREBASE_DATABASE_URL=https://datn-wd47-default-rtdb.asia-southeast1.firebasedatabase.app